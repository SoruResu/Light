ACCENT_CYAN = "#00F5D4"
COLOR_RED = "#FF6B6B"
COLOR_GREEN = "#51CF66"
COLOR_BLUE = "#4DABF7"

KEY_MAP = {
    **{chr(c): getattr(ecodes, f"KEY_{chr(c)}") for c in range(ord("A"), ord("Z") + 1) if HAS_EVDEV},
    **{str(d): getattr(ecodes, f"KEY_{d}") for d in range(10) if HAS_EVDEV},
    **{f"F{i}": getattr(ecodes, f"KEY_F{i}") for i in range(1, 13) if HAS_EVDEV},
    **{f"NUM{d}": getattr(ecodes, f"KEY_KP{d}") for d in range(10) if HAS_EVDEV},
}


def parse_hotkey(hotkey_str):
    if not hotkey_str or not hotkey_str.strip() or not HAS_EVDEV:
        return None
    parts = [p.strip().upper() for p in hotkey_str.split("+") if p.strip()]
    if len(parts) < 2:
        return None

    mods = set()
    for part in parts[:-1]:
        if part in ("CTRL", "CONTROL"):
            mods.add("CTRL")
        elif part == "ALT":
            mods.add("ALT")
        elif part == "SHIFT":
            mods.add("SHIFT")
        else:
            return None

    key_part = parts[-1]
    if key_part not in KEY_MAP or not mods:
        return None
    return mods, KEY_MAP[key_part]


def compute_lut_curves(gamma, brightness, contrast, r_mult, g_mult, b_mult):
    curves = []
    for mult in (r_mult, g_mult, b_mult):
        ch_vals = []
        for i in range(256):
            val = i / 255.0
            val = (val - 0.5) * contrast + 0.5 + brightness
            val = max(0.0, min(1.0, val))
            val = pow(val, 1.0 / gamma) * mult
            val = max(0.0, min(1.0, val))
            ch_vals.append(val)
        curves.append(ch_vals)
    return curves


def set_gamma_ramp(gamma=1.0, brightness=0.0, contrast=1.0, r_mult=1.0, g_mult=1.0, b_mult=1.0):
    curves = compute_lut_curves(gamma, brightness, contrast, r_mult, g_mult, b_mult)

    eff_r = max(0.1, min(5.0, gamma * r_mult * contrast))
    eff_g = max(0.1, min(5.0, gamma * g_mult * contrast))
    eff_b = max(0.1, min(5.0, gamma * b_mult * contrast))
    eff_bright = max(0.1, min(1.0, 1.0 + brightness))

    try:
        subprocess.run(
            [
                "gammastep", "-P", "-O", "6500",
                "-g", f"{eff_r:.2f}:{eff_g:.2f}:{eff_b:.2f}",
                "-b", f"{eff_bright:.2f}",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.5,
        )
        return True, curves
    except Exception:
        return False, curves


def create_moderamina_lucis_icon():
    size = 36
    img = tk.PhotoImage(width=size, height=size)
    cx, cy = (size - 1) / 2.0, (size - 1) / 2.0

    for y in range(size):
        for x in range(size):
            dx, dy = x - cx, y - cy
            dist = math.hypot(dx, dy)
            if dist <= 16.5:
                if dist > 15.0:
                    img.put("#30363D", (x, y))
                elif dist <= 10.5:
                    if (dx + dy) < 0:
                        color = "#FFD166" if dist < 8.0 else "#F77F00"
                    else:
                        color = "#14213D"
                    nx, ny = dx / 9.5, -dy / 9.5
                    t = max(0.0, min(1.0, (nx + 1.0) / 2.0))
                    if abs(ny - (2.0 * (t ** 2.2) - 1.0)) < 0.16:
                        color = "#00F5D4"
                    img.put(color, (x, y))
                else:
                    angle = math.atan2(dy, dx)
                    ray_offset = abs(((angle + math.pi / 8) % (math.pi / 4)) - (math.pi / 8))
                    if ray_offset < 0.11 and dist < 14.5:
                        img.put("#F77F00" if (dx + dy) < 0 else "#4A5568", (x, y))
                    else:
                        img.put("#161B22", (x, y))
    return img
