    def make_btn(self, parent, text, cmd, bg_color, fg_color):
        return tk.Button(
            parent, text=text, command=cmd, bg=bg_color, fg=fg_color,
            activebackground=bg_color, activeforeground=fg_color,
            relief="flat", font=("Sans", 8, "bold"), padx=10, pady=3, cursor="hand2",
        )

    def capture_hotkey(self, event):
        if event.keysym in ("BackSpace", "Delete", "Escape"):
            self.hotkey_entry.delete(0, tk.END)
            return "break"
        if event.keysym in ("Control_L", "Control_R", "Alt_L", "Alt_R", "Shift_L", "Shift_R", "Super_L", "Super_R"):
            return "break"

        parts = []
        if event.state & 0x0004:
            parts.append("Ctrl")
        if event.state & 0x0008 or event.state & 0x0080:
            parts.append("Alt")
        if event.state & 0x0001:
            parts.append("Shift")

        key = event.keysym.upper()
        if key.startswith("KP_"):
            key = "NUM" + key[3:]

        if parts and key in KEY_MAP:
            parts.append(key)
            self.hotkey_entry.delete(0, tk.END)
            self.hotkey_entry.insert(0, "+".join(parts))
        return "break"

    def draw_color_curve(self, curves):
        c = self.curve_canvas
        c.delete("all")
        w, h, pad_x, pad_y = 390, 135, 10, 10
        plot_w, plot_h = w - 2 * pad_x, h - 2 * pad_y

        for frac in (0.25, 0.5, 0.75):
            gx = pad_x + frac * plot_w
            gy = pad_y + frac * plot_h
            c.create_line(gx, pad_y, gx, h - pad_y, fill="#1B222C", width=1)
            c.create_line(pad_x, gy, w - pad_x, gy, fill="#1B222C", width=1)

        c.create_line(pad_x, h - pad_y, w - pad_x, pad_y, fill="#30363D", dash=(4, 4), width=1)

        for ch_idx, color in enumerate((COLOR_RED, COLOR_GREEN, COLOR_BLUE)):
            pts = []
            for i in range(0, 256, 8):
                pts.extend((pad_x + (i / 255.0) * plot_w, (h - pad_y) - curves[ch_idx][i] * plot_h))
            pts.extend((pad_x + plot_w, (h - pad_y) - curves[ch_idx] * plot_h))
            c.create_line(*pts, fill=color, width=2)
    def update_display(self, _=None):
        g, br, ct = self.gamma_var.get(), self.bright_var.get(), self.contrast_var.get()
        r, gr, b = self.r_var.get(), self.g_var.get(), self.b_var.get()

        self.val_labels["gamma"].config(text=f"{g:.2f}")
        self.val_labels["bright"].config(text=f"{br:+.2f}")
        self.val_labels["contrast"].config(text=f"{ct:.2f}")
        self.val_labels["r"].config(text=f"{r:.2f}")
        self.val_labels["g"].config(text=f"{gr:.2f}")
        self.val_labels["b"].config(text=f"{b:.2f}")

        if getattr(self, "_render_job", None) is not None:
            self.root.after_cancel(self._render_job)
        self._render_job = self.root.after(40, self._apply_and_draw)

    def _apply_and_draw(self):
        self._render_job = None
        ok, curves = set_gamma_ramp(
            self.gamma_var.get(), self.bright_var.get(), self.contrast_var.get(),
            self.r_var.get(), self.g_var.get(), self.b_var.get(),
        )
        self.draw_color_curve(curves)
        if not ok:
            self.status_lbl.config(text="Install 'gammastep' to apply display LUT", fg=COLOR_RED)

    def apply_values(self, vals):
        self.gamma_var.set(vals.get("gamma", 1.0))
        self.bright_var.set(vals.get("brightness", 0.0))
        self.contrast_var.set(vals.get("contrast", 1.0))
        self.r_var.set(vals.get("r", 1.0))
        self.g_var.set(vals.get("g", 1.0))
        self.b_var.set(vals.get("b", 1.0))
        self.update_display()

    def reset_values(self):
        self.apply_values({"gamma": 1.0, "brightness": 0.0, "contrast": 1.0, "r": 1.0, "g": 1.0, "b": 1.0})
        self.status_lbl.config(text="Reset to default linear ramp", fg=TEXT_MUTED)

    def load_profiles(self):
        if os.path.exists(PROFILES_FILE):
            try:
                with open(PROFILES_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
        return [
            {"name": "Default (Linear)", "hotkey": "Ctrl+Alt+0", "gamma": 1.0, "brightness": 0.0, "contrast": 1.0, "r": 1.0, "g": 1.0, "b": 1.0},
            {"name": "Gaming Shadow Boost", "hotkey": "Ctrl+Alt+1", "gamma": 1.45, "brightness": 0.04, "contrast": 1.15, "r": 1.0, "g": 1.0, "b": 1.0},
            {"name": "Nocturnal Warm", "hotkey": "Ctrl+Alt+2", "gamma": 0.95, "brightness": -0.04, "contrast": 1.0, "r": 1.0, "g": 0.84, "b": 0.62},
        ]

    def write_profiles(self):
        with open(PROFILES_FILE, "w", encoding="utf-8") as f:
            json.dump(self.profiles, f, indent=2)

    def refresh_profile_list(self):
        items = [f"{p['name']}  [{p['hotkey']}]" if p.get("hotkey") else p["name"] for p in self.profiles]
        self.profile_combo["values"] = items
        if items:
            self.profile_combo.current(0)

    def on_profile_selected(self, _=None):
        idx = self.profile_combo.current()
        if 0 <= idx < len(self.profiles):
            p = self.profiles[idx]
            self.name_entry.delete(0, tk.END)
            self.name_entry.insert(0, p["name"])
            self.hotkey_entry.delete(0, tk.END)
            self.hotkey_entry.insert(0, p.get("hotkey", ""))

    def apply_selected_profile(self):
        idx = self.profile_combo.current()
        if 0 <= idx < len(self.profiles):
            p = self.profiles[idx]
            self.apply_values(p)
            self.status_lbl.config(text=f"Active Profile: {p['name']}", fg=ACCENT_CYAN)

    def save_current_as_profile(self):
        name = self.name_entry.get().strip()
        hk = self.hotkey_entry.get().strip()
        if not name:
            messagebox.showwarning("Missing Name", "Please enter a name for this profile.")
            return
        if hk and parse_hotkey(hk) is None:
            messagebox.showwarning("Invalid Hotkey", "Use a modifier + key (e.g., Ctrl+Alt+3 or Shift+F5).")
            return

        new_entry = {
            "name": name, "hotkey": hk,
            "gamma": round(self.gamma_var.get(), 3),
            "brightness": round(self.bright_var.get(), 3),
            "contrast": round(self.contrast_var.get(), 3),
            "r": round(self.r_var.get(), 3),
            "g": round(self.g_var.get(), 3),
            "b": round(self.b_var.get(), 3),
        }

        updated = False
        for i, p in enumerate(self.profiles):
            if p["name"].lower() == name.lower():
                self.profiles[i] = new_entry
                updated = True
                break
        if not updated:
            self.profiles.append(new_entry)

        self.write_profiles()
        self.refresh_profile_list()
        self.restart_hotkey_listener()
        self.status_lbl.config(text=f"Saved profile: {name}", fg=ACCENT_GOLD)

    def delete_selected_profile(self):
        idx = self.profile_combo.current()
        if 0 <= idx < len(self.profiles):
            removed = self.profiles.pop(idx)
            self.write_profiles()
            self.refresh_profile_list()
            self.restart_hotkey_listener()
            self.status_lbl.config(text=f"Deleted: {removed['name']}", fg=TEXT_MUTED)

    def restart_hotkey_listener(self):
        self.hotkey_stop_event.set()
        if self.hotkey_thread and self.hotkey_thread.is_alive():
            self.hotkey_thread.join(timeout=0.5)

        if not HAS_EVDEV:
            self.status_lbl.config(text="Install python3-evdev for global hotkeys", fg=TEXT_MUTED)
            return

        self.hotkey_stop_event.clear()
        parsed_profiles = []
        for prof in self.profiles:
            parsed = parse_hotkey(prof.get("hotkey", ""))
            if parsed:
                parsed_profiles.append((parsed, parsed, dict(prof)))

        def listen():
            devices = []
            for path in glob.glob("/dev/input/event*"):
                try:
                    dev = evdev.InputDevice(path)
                    if ecodes.EV_KEY in dev.capabilities():
                        devices.append(dev)
                except Exception:
                    pass

            if not devices:
                self.root.after(0, lambda: self.status_lbl.config(
                    text="Hotkeys disabled (add user to 'input' group)", fg=TEXT_MUTED
                ))
                return

            self.root.after(0, lambda: self.status_lbl.config(text="Global Hotkeys Active", fg=TEXT_MUTED))
            pressed_keys = set()

            while not self.hotkey_stop_event.is_set():
                r, _, _ = select.select(devices, [], [], 0.2)
                for dev in r:
                    try:
                        for event in dev.read():
                            if event.type == ecodes.EV_KEY:
                                if event.value == 1:
                                    pressed_keys.add(event.code)
                                    active_mods = set()
                                    if ecodes.KEY_LEFTCTRL in pressed_keys or ecodes.KEY_RIGHTCTRL in pressed_keys:
                                        active_mods.add("CTRL")
                                    if ecodes.KEY_LEFTALT in pressed_keys or ecodes.KEY_RIGHTALT in pressed_keys:
                                        active_mods.add("ALT")
                                    if ecodes.KEY_LEFTSHIFT in pressed_keys or ecodes.KEY_RIGHTSHIFT in pressed_keys:
                                        active_mods.add("SHIFT")

                                    for req_mods, req_key, prof in parsed_profiles:
                                        if event.code == req_key and active_mods == req_mods:
                                            self.root.after(0, lambda p=prof: self.trigger_hotkey_profile(p))
                                elif event.value == 0:
                                    pressed_keys.discard(event.code)
                    except Exception:
                        pass

        self.hotkey_thread = threading.Thread(target=listen, daemon=True)
        self.hotkey_thread.start()

    def trigger_hotkey_profile(self, prof):
        self.apply_values(prof)
        self.status_lbl.config(text=f"Hotkey Triggered: {prof['name']} ({prof['hotkey']})", fg=ACCENT_GOLD)

    def on_close(self):
        self.hotkey_stop_event.set()
        self.reset_values()
        self.root.destroy()


